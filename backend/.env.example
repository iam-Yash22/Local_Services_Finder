APP_ENV=development
DATABASE_URL=sqlite:///./localservicefinder.db
JWT_SECRET_KEY=replace-this-with-a-unique-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Comma-separated email addresses granted the admin role when they register.
ADMIN_EMAILS=admin123@gmail.com
# Optional assistant integrations. Create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
